# OPENAI_OAUTH_CLIENT_ID: Optional pre-registered Sign in with ChatGPT OAuth client ID (oaiapp_...).
# If omitted, Semantic Router Studio uses OpenAI's dynamic_agent_client PKCE registration flow.
OPENAI_OAUTH_CLIENT_ID=""

# OPENAI_OAUTH_CLIENT_SECRET: Optional client secret for confidential website OAuth clients.
OPENAI_OAUTH_CLIENT_SECRET=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
